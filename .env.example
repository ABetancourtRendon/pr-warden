# PR-Warden environment configuration (copy to .env - it is gitignored).
# All LLM traffic uses an OpenAI-compatible request format through one thin adapter.

# Default preset: Google Gemini (OpenAI-compatible endpoint).
# Get your free key at https://aistudio.google.com (Google AI Studio).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Alternative preset: OpenRouter (https://openrouter.ai)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# Optional: GitHub token. Public repos work without it; a token raises API rate
# limits and is required to post reviews to PRs.
# GITHUB_TOKEN=
